# ===== AraLink Environment =====
PORT=3000

# Gemini API key — fallback translation engine (primary is free Google endpoint)
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# نموذج Whisper للتفريغ الصوتي (افتراضي whisper-tiny سريع؛ whisper-small/whisper-base أدق لكنهما أبطأ بكثير)
WHISPER_MODEL=Xenova/whisper-tiny

# محرك التفريغ الصوتي: sherpa (أسرع بكثير — whisper-tiny.en عبر sherpa-onnx، يُنزَّل النموذج تلقائيًا)
# أو transformers (الاحتياطي عبر Xenova whisper-tiny). إن لم يُثبَّت sherpa-onnx يُستخدم transformers تلقائيًا.
STT_ENGINE=sherpa

# مجلد النماذج (يُنزَّل فيه نموذج sherpa تلقائيًا عند أول تشغيل — لا يُدرج في git)
# MODEL_DIR=models
