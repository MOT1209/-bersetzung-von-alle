# ===== AraLink Environment =====
PORT=3000

# Gemini API key — fallback translation engine (primary is free Google endpoint)
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== مسار الفيديو: Gemini تجلب رابط يوتيوب بنفسها =====
# يحل حجب يوتيوب لعناوين مراكز البيانات: خوادم Google تجلب الفيديو لا خادمنا.
# هذا المسار هو الوحيد الذي يجعل روابط يوتيوب تعمل على Render، ويتطلب
# GEMINI_API_KEY أعلاه — بلا مفتاح تبقى الروابط معطّلة هناك.
# الحصة المجانية: 8 ساعات فيديو يوميًا. الفيديوهات العامة فقط.
# GEMINI_VIDEO=false                    # لتعطيل المسار صراحةً
# GEMINI_VIDEO_MODEL=gemini-2.5-flash
# MAX_VIDEO_MINUTES=20                  # ~300 رمز لكل ثانية فيديو — الحد يحمي حصتك

# نموذج Whisper للتفريغ الصوتي (افتراضي whisper-tiny سريع؛ whisper-small/whisper-base أدق لكنهما أبطأ بكثير)
WHISPER_MODEL=Xenova/whisper-tiny

# محرك التفريغ الصوتي: sherpa (أسرع بكثير — whisper-tiny.en عبر sherpa-onnx، يُنزَّل النموذج تلقائيًا)
# أو transformers (الاحتياطي عبر Xenova whisper-tiny). إن لم يُثبَّت sherpa-onnx يُستخدم transformers تلقائيًا.
STT_ENGINE=sherpa

# نموذج التفريغ الصوتي — الأثر الأكبر على جودة العربية والتركية.
# tiny (39MB) سريع لكنه ضعيف جدًا على العربية؛ small (244MB) أدق بفارق كبير.
# اللغات المستهدفة: ar / de / tr / en — مرّر لغة الفيديو صراحةً لرفع الدقة.
# WHISPER_MODEL=Xenova/whisper-small

# مجلد النماذج (يُنزَّل فيه نموذج sherpa تلقائيًا عند أول تشغيل — لا يُدرج في git)
# MODEL_DIR=models

# مسار ملف كاش الترجمة (الافتراضي: cache/translation-cache.json)
# ⚠️ نظام ملفات Render المجاني مؤقت — الكاش يختفي عند كل إعادة نشر أو خمول.
# وجّهه إلى قرص دائم إن أردت بقاءه.
# CACHE_FILE=cache/translation-cache.json
# مدة صلاحية الكاش بالمللي ثانية (الافتراضي: 30 يومًا = 2592000000)
# اضبطها 0 لتعطيل الانتهاء (يبقى مقيدًا بالحد الأقصى للعدد فقط)
# CACHE_TTL_MS=2592000000

# ===== لوحة جودة الترجمة =====
# تقرير القياس الذي يكتبه `npm run bench:translate` وتقرأه لوحة التحكم
# (GET /api/stats/quality). الافتراضي: cache/quality-report.json
# CACHE على Render مؤقت — أعد تشغيل القياس بعد كل نشر أو وجّهه لقرص دائم.
# QUALITY_REPORT=cache/quality-report.json
# مجموعة الجُمل المرجعية (الافتراضي: samples/translation/refset.json)
# QUALITY_REFSET=samples/translation/refset.json

# مفتاح API اختياري للطلاب (إن ضُبط: الطلبات التي تحمله تحصل على حد أعلى ×3)
# ⚠️ مفتاح حصص فقط — لا يمنح أي صلاحية إدارية.
# ARALINK_API_KEY=


# ===== CORS =====
# قائمة بيضاء للأصول المسموحة عبر المتصفح (فاصلة لأكثر من أصل، أو '*' للكل).
# فارغة = نفس الأصل فقط (الافتراضي الآمن) — الواجهة تستخدم روابط نسبية بلا تأثير.
# CORS_ORIGIN=
# ===== رمز الإدارة — يفتح /api/settings (قراءة وكتابة .env وقواعد الاستخراج) =====
# إن لم يُضبط: مسار /api/settings معطّل بالكامل ويُرجع 503 (الافتراضي الآمن).
# اضبطه فقط إن كنت تحتاج نافذة الإعدادات، وأرسله في ترويسة x-admin-token.
# ⚠️ لا تضبطه أبدًا على نشر عام بلا سبب: من يملكه يستطيع تحويل مفاتيحك
# إلى خادم غريب عبر ZEN_BASE_URL.
# ولّده بأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_TOKEN=

# بريد MyMemory الاختياري — يرفع الحصة اليومية المجانية للترجمة
# MYMEMORY_EMAIL=you@example.com

# عنوان خادم LibreTranslate الاحتياطي (اختياري)
# LIBRE_URL=https://libretranslate.com

# ===== مزوّدات ترجمة اختيارية (مجانية) =====
# DeepL المجاني — مفتاح اختياري من deeple.com/pro-api (مجاني)
# DEEPL_API_KEY=
# opencode zen — بوابة متوافقة مع OpenAI (chat/completions بمصادقة Bearer).
# المفتاح من https://opencode.ai/zen — وفيها نماذج مجانية.
# ZEN_API_KEY=
# الافتراضي https://opencode.ai/zen/v1 — غيّره لأي خادم متوافق
# (Ollama: http://localhost:11434/v1 — LM Studio: http://localhost:1234/v1)
# ZEN_BASE_URL=https://opencode.ai/zen/v1
# ZEN_MODEL=deepseek-v4-flash-free
# ترتيب المزوّدين المفضّل (فاصلة) — تُتخطى المزوّدات غير المتوفرة تلقائيًا
# PROVIDER_ORDER=google,mymemory,libre,gemini

# حدود الطلبات (طلبات/دقيقة لكل IP)
RATE_LIMIT_MAX=20
RATE_LIMIT_MAX_HEAVY=10

# أقصى مدة فيديو محلي بالدقائق (الافتراضي 5 — التفريغ الصوتي بطيء ~5.5x المدة)
# LOCAL_VIDEO_MAX_MIN=5
