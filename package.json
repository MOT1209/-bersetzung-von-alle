{
  "name": "aralink",
  "version": "1.0.0",
  "description": "أداة الترجمة الذكية — ترجم أي رابط (يوتيوب، مقالات، مواقع) إلى أي لغة",
  "type": "commonjs",
  "main": "server/server.js",
  "scripts": {
    "dev": "node server/server.js",
    "start": "node server/server.js",
    "check": "node scripts/check.js",
    "test": "node --test \"tests/*.test.js\" \"tests/*.test.mjs\"",
    "test:coverage": "c8 node --test \"tests/*.test.js\" \"tests/*.test.mjs\"",
    "test:coverage:html": "c8 --reporter=html node --test \"tests/*.test.js\" \"tests/*.test.mjs\"",
    "test:coverage:lcov": "c8 --reporter=lcov node --test \"tests/*.test.js\" \"tests/*.test.mjs\"",
    "lint": "eslint server/ tests/ public/js/ agents/ --max-warnings=0",
    "lint:mjs": "eslint public/js/*.mjs tests/*.test.mjs --max-warnings=0",
    "download:ocr": "node scripts/download-ocr-data.js",
    "bench:translate": "node scripts/bench-translate.js",
    "perf:translate": "node scripts/perf-translate.js",
    "demo:media": "node scripts/demo-media.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cheerio": "^1.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.3.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "sherpa-onnx": "^1.13.4",
    "tesseract.js": "^7.0.0",
    "undici": "^7.29.0",
    "youtube-transcript": "^1.2.1"
  },
  "optionalDependencies": {
    "msedge-tts": "^2.0.7",
    "redis": "^4.7.1",
    "youtube-dl-exec": "^3.1.9"
  },
  "overrides": {
    "protobufjs": "^7.6.6",
    "qs": "^6.16.0",
    "sharp": "^0.35.4",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "^10.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
